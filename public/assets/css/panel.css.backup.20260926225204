:root {
    --bg: #0b1120;
    --panel: #111827;
    --panel-2: #172033;
    --border: #263247;
    --text: #e5e7eb;
    --muted: #94a3b8;
    --accent: #38bdf8;
    --success: #34d399;
    --danger: #fb7185;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
}

a {
    color: inherit;
    text-decoration: none;
}

.login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
}

.login-card {
    width: min(420px, 100%);
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, .35);
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.brand-mark {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--accent);
    color: #00111a;
    font-weight: 800;
}

.brand strong,
.brand span {
    display: block;
}

.brand span {
    color: var(--muted);
    font-size: 13px;
    margin-top: 3px;
}

h1 {
    margin: 28px 0 6px;
}

.muted {
    color: var(--muted);
}

label {
    display: block;
    margin: 20px 0 7px;
    font-size: 14px;
}

input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: #0f172a;
    color: var(--text);
    outline: none;
}

button {
    width: 100%;
    margin-top: 24px;
    padding: 12px;
    border: 0;
    border-radius: 9px;
    background: var(--accent);
    color: #00111a;
    font-weight: 700;
    cursor: pointer;
}

.alert {
    margin-top: 18px;
    padding: 11px 13px;
    border-radius: 8px;
    background: rgba(251, 113, 133, .12);
    color: #fda4af;
}

.topbar {
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    border-bottom: 1px solid var(--border);
    background: var(--panel);
}

.user-menu {
    display: flex;
    gap: 18px;
    align-items: center;
    color: var(--muted);
}

.user-menu a {
    color: var(--text);
}

.layout {
    min-height: calc(100vh - 68px);
    display: flex;
}

.sidebar {
    width: 230px;
    padding: 20px 12px;
    border-right: 1px solid var(--border);
    background: #0d1526;
}

.sidebar a {
    display: block;
    padding: 11px 13px;
    margin-bottom: 4px;
    border-radius: 8px;
    color: var(--muted);
}

.sidebar a:hover,
.sidebar a.active {
    background: var(--panel-2);
    color: var(--text);
}

.content {
    flex: 1;
    padding: 30px;
    max-width: 1500px;
}

.page-heading {
    margin-bottom: 24px;
}

.page-heading h1 {
    margin: 0;
}

.page-heading p {
    color: var(--muted);
}

.cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
}

.card,
.panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
}

.card {
    padding: 20px;
}

.card span,
.card small,
.info-grid span {
    color: var(--muted);
    display: block;
}

.card strong {
    display: block;
    font-size: 28px;
    margin-top: 10px;
}

.card small {
    margin-top: 5px;
}

.panel {
    margin-top: 20px;
    padding: 22px;
}

.panel h2 {
    margin-top: 0;
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.info-grid strong {
    display: block;
    margin-top: 7px;
}

.services {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.service {
    display: flex;
    justify-content: space-between;
    padding: 13px;
    border-radius: 8px;
    background: #0d1526;
}

.status-active {
    color: var(--success);
}

.status-inactive {
    color: var(--danger);
}

@media (max-width: 900px) {
    .cards {
        grid-template-columns: repeat(2, 1fr);
    }

    .sidebar {
        display: none;
    }

    .info-grid,
    .services {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 600px) {
    .cards {
        grid-template-columns: 1fr;
    }

    .content {
        padding: 18px;
    }
}
