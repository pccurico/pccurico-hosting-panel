:root {
    --bg: #0b1120;
    --panel: #111827;
    --panel-2: #172033;
    --border: #263247;
    --text: #e5e7eb;
    --muted: #94a3b8;
    --accent: #38bdf8;
    --success: #34d399;
    --danger: #fb7185;
}

* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Inter, Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
}

a {
    color: inherit;
    text-decoration: none;
}

.login-page {
    min-height: 100vh;
    display: grid;
    place-items: center;
    padding: 24px;
}

.login-card {
    width: min(420px, 100%);
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 32px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, .35);
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
}

.brand-mark {
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: var(--accent);
    color: #00111a;
    font-weight: 800;
}

.brand strong,
.brand span {
    display: block;
}

.brand span {
    color: var(--muted);
    font-size: 13px;
    margin-top: 3px;
}

h1 {
    margin: 28px 0 6px;
}

.muted {
    color: var(--muted);
}

label {
    display: block;
    margin: 20px 0 7px;
    font-size: 14px;
}

input {
    width: 100%;
    padding: 12px 14px;
    border: 1px solid var(--border);
    border-radius: 9px;
    background: #0f172a;
    color: var(--text);
    outline: none;
}

button {
    width: 100%;
    margin-top: 24px;
    padding: 12px;
    border: 0;
    border-radius: 9px;
    background: var(--accent);
    color: #00111a;
    font-weight: 700;
    cursor: pointer;
}

.alert {
    margin-top: 18px;
    padding: 11px 13px;
    border-radius: 8px;
    background: rgba(251, 113, 133, .12);
    color: #fda4af;
}

.topbar {
    height: 68px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    border-bottom: 1px solid var(--border);
    background: var(--panel);
}

.user-menu {
    display: flex;
    gap: 18px;
    align-items: center;
    color: var(--muted);
}

.user-menu a {
    color: var(--text);
}

.layout {
    min-height: calc(100vh - 68px);
    display: flex;
}

.sidebar {
    width: 230px;
    padding: 20px 12px;
    border-right: 1px solid var(--border);
    background: #0d1526;
}

.sidebar a {
    display: block;
    padding: 11px 13px;
    margin-bottom: 4px;
    border-radius: 8px;
    color: var(--muted);
}

.sidebar a:hover,
.sidebar a.active {
    background: var(--panel-2);
    color: var(--text);
}

.content {
    flex: 1;
    padding: 30px;
    max-width: 1500px;
}

.page-heading {
    margin-bottom: 24px;
}

.page-heading h1 {
    margin: 0;
}

.page-heading p {
    color: var(--muted);
}

.cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
}

.card,
.panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 14px;
}

.card {
    padding: 20px;
}

.card span,
.card small,
.info-grid span {
    color: var(--muted);
    display: block;
}

.card strong {
    display: block;
    font-size: 28px;
    margin-top: 10px;
}

.card small {
    margin-top: 5px;
}

.panel {
    margin-top: 20px;
    padding: 22px;
}

.panel h2 {
    margin-top: 0;
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.info-grid strong {
    display: block;
    margin-top: 7px;
}

.services {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
}

.service {
    display: flex;
    justify-content: space-between;
    padding: 13px;
    border-radius: 8px;
    background: #0d1526;
}

.status-active {
    color: var(--success);
}

.status-inactive {
    color: var(--danger);
}

@media (max-width: 900px) {
    .cards {
        grid-template-columns: repeat(2, 1fr);
    }

    .sidebar {
        display: none;
    }

    .info-grid,
    .services {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 600px) {
    .cards {
        grid-template-columns: 1fr;
    }

    .content {
        padding: 18px;
    }
}

/* ============================================================
   PCCURICO HOSTING PANEL - DASHBOARD
   ============================================================ */

:root {
    --panel-bg: #f4f6f9;
    --panel-card: #ffffff;
    --panel-border: #e4e8ee;
    --panel-text: #172033;
    --panel-muted: #6d7686;
    --panel-dark: #111827;
    --panel-accent: #1f6feb;
    --panel-success: #16834b;
    --panel-danger: #c83b3b;
    --panel-sidebar: #111827;
}

* {
    box-sizing: border-box;
}

body.panel-page {
    margin: 0;
    background: var(--panel-bg);
    color: var(--panel-text);
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
}

.topbar {
    height: 68px;
    background: #ffffff;
    border-bottom: 1px solid var(--panel-border);
    display: flex;
    align-items: center;
    padding: 0 26px;
    gap: 24px;
}

.topbar-brand {
    display: flex;
    align-items: center;
    gap: 11px;
    min-width: 230px;
}

.brand-mark {
    width: 38px;
    height: 38px;
    border-radius: 9px;
    background: var(--panel-dark);
    color: #ffffff;
    display: grid;
    place-items: center;
    font-size: 20px;
    font-weight: 800;
}

.brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
}

.brand-text strong {
    font-size: 14px;
    letter-spacing: .08em;
}

.brand-text span {
    color: var(--panel-muted);
    font-size: 11px;
    margin-top: 3px;
}

.topbar-server {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--panel-muted);
    font-size: 13px;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--panel-success);
    display: inline-block;
}

.logout-link {
    color: var(--panel-muted);
    text-decoration: none;
    font-size: 13px;
    margin-left: 18px;
}

.logout-link:hover {
    color: var(--panel-text);
}

.panel-shell {
    display: flex;
    min-height: calc(100vh - 68px);
}

.sidebar {
    width: 238px;
    background: var(--panel-sidebar);
    color: #ffffff;
    padding: 24px 14px;
    flex-shrink: 0;
}

.sidebar-title {
    padding: 0 12px 12px;
    color: #7f899a;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
}

.sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.nav-item {
    display: flex;
    align-items: center;
    gap: 11px;
    min-height: 42px;
    padding: 0 12px;
    border-radius: 7px;
    color: #aeb7c6;
    text-decoration: none;
    font-size: 13px;
}

.nav-item span {
    width: 18px;
    text-align: center;
    opacity: .8;
}

.nav-item:hover {
    background: rgba(255,255,255,.06);
    color: #ffffff;
}

.nav-item.active {
    background: rgba(255,255,255,.10);
    color: #ffffff;
}

.sidebar-divider {
    height: 1px;
    background: rgba(255,255,255,.08);
    margin: 14px 8px;
}

.dashboard {
    flex: 1;
    padding: 30px;
    max-width: 1500px;
}

.page-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 28px;
}

.eyebrow {
    color: var(--panel-accent);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: .14em;
    margin-bottom: 7px;
}

.page-heading h1 {
    margin: 0;
    font-size: 29px;
    letter-spacing: -.03em;
}

.page-heading p {
    margin: 7px 0 0;
    color: var(--panel-muted);
    font-size: 14px;
}

.server-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 13px;
    border: 1px solid var(--panel-border);
    border-radius: 7px;
    background: #ffffff;
    color: var(--panel-muted);
    font-size: 12px;
}

.metrics-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 18px;
}

.metric-card,
.panel-card {
    background: var(--panel-card);
    border: 1px solid var(--panel-border);
    border-radius: 9px;
}

.metric-card {
    padding: 20px;
}

.metric-label {
    color: var(--panel-muted);
    font-size: 12px;
    font-weight: 600;
}

.metric-value {
    margin-top: 10px;
    font-size: 25px;
    font-weight: 750;
    letter-spacing: -.03em;
}

.metric-detail {
    margin-top: 3px;
    color: var(--panel-muted);
    font-size: 12px;
}

.metric-foot {
    margin-top: 10px;
    color: var(--panel-muted);
    font-size: 11px;
}

.progress {
    height: 5px;
    margin-top: 15px;
    border-radius: 5px;
    overflow: hidden;
    background: #edf0f4;
}

.progress-bar {
    height: 100%;
    border-radius: inherit;
    background: var(--panel-accent);
}

.dashboard-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 18px;
    margin-bottom: 18px;
}

.panel-card {
    overflow: hidden;
}

.card-header {
    min-height: 68px;
    padding: 18px 20px;
    border-bottom: 1px solid var(--panel-border);
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.card-title {
    font-size: 14px;
    font-weight: 750;
}

.card-subtitle {
    margin-top: 4px;
    color: var(--panel-muted);
    font-size: 11px;
}

.live-badge {
    padding: 5px 8px;
    border-radius: 5px;
    background: #edf8f2;
    color: var(--panel-success);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: .08em;
}

.service-list {
    padding: 5px 20px 10px;
}

.service-row {
    min-height: 58px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #edf0f4;
}

.service-row:last-child {
    border-bottom: 0;
}

.service-info {
    display: flex;
    align-items: center;
    gap: 11px;
}

.service-info strong {
    display: block;
    font-size: 12px;
}

.service-info small {
    display: block;
    color: var(--panel-muted);
    font-size: 10px;
    margin-top: 3px;
}

.service-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
}

.service-dot.online {
    background: var(--panel-success);
}

.service-dot.offline {
    background: var(--panel-danger);
}

.service-status {
    font-size: 11px;
    font-weight: 650;
}

.online-text {
    color: var(--panel-success);
}

.offline-text {
    color: var(--panel-danger);
}

.info-list {
    padding: 7px 20px 12px;
}

.info-row {
    min-height: 47px;
    border-bottom: 1px solid #edf0f4;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.info-row:last-child {
    border-bottom: 0;
}

.info-row span {
    color: var(--panel-muted);
    font-size: 11px;
}

.info-row strong {
    text-align: right;
    font-size: 11px;
    font-weight: 650;
}

.load-card {
    margin-bottom: 20px;
}

.load-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 22px;
    gap: 1px;
    background: var(--panel-border);
}

.load-grid > div {
    background: #ffffff;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.load-grid span {
    color: var(--panel-muted);
    font-size: 11px;
}

.load-grid strong {
    font-size: 23px;
}

@media (max-width: 1050px) {
    .metrics-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .dashboard-grid {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 760px) {
    .sidebar {
        display: none;
    }

    .dashboard {
        padding: 20px;
    }

    .metrics-grid {
        grid-template-columns: 1fr;
    }

    .page-heading {
        flex-direction: column;
        gap: 16px;
    }

    .topbar {
        padding: 0 16px;
    }

    .topbar-server {
        display: none;
    }

    .load-grid {
        grid-template-columns: 1fr;
    }
}

/* ============================================================
   HOSTING / SITIOS
   ============================================================ */

.page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: 24px;
}

.page-eyebrow {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .12em;
    opacity: .65;
    margin-bottom: 6px;
}

.page-title {
    margin: 0;
}

.page-description {
    margin: 7px 0 0;
    opacity: .68;
}

.page-header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
}

.service-badge,
.site-status,
.ssl-badge,
.site-alias {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    border-radius: 999px;
    white-space: nowrap;
}

.service-badge {
    padding: 8px 12px;
    font-size: 12px;
    font-weight: 600;
}

.status-ok {
    background: rgba(34, 197, 94, .10);
    color: #16a34a;
}

.status-warning {
    background: rgba(234, 179, 8, .12);
    color: #ca8a04;
}

.service-dot,
.site-status span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    display: inline-block;
    background: currentColor;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-bottom: 20px;
}

.panel-stat-card {
    padding: 20px;
    border: 1px solid rgba(148, 163, 184, .18);
    border-radius: 14px;
    background: var(--panel-card-bg, #fff);
}

.panel-stat-label {
    font-size: 12px;
    opacity: .62;
    margin-bottom: 8px;
}

.panel-stat-value {
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
}

.panel-stat-meta {
    margin-top: 6px;
    font-size: 12px;
    opacity: .55;
}

.panel-card {
    border: 1px solid rgba(148, 163, 184, .18);
    border-radius: 14px;
    background: var(--panel-card-bg, #fff);
    overflow: hidden;
    margin-bottom: 20px;
}

.panel-card-header {
    padding: 20px 22px;
    border-bottom: 1px solid rgba(148, 163, 184, .14);
}

.panel-card-header h2 {
    margin: 0;
    font-size: 17px;
}

.panel-card-header p {
    margin: 6px 0 0;
    font-size: 13px;
    opacity: .62;
}

.sites-table-wrapper {
    width: 100%;
    overflow-x: auto;
}

.sites-table {
    width: 100%;
    border-collapse: collapse;
    min-width: 980px;
}

.sites-table th,
.sites-table td {
    padding: 15px 18px;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid rgba(148, 163, 184, .12);
}

.sites-table th {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .06em;
    opacity: .58;
    font-weight: 700;
}

.sites-table td {
    font-size: 13px;
}

.sites-table tbody tr:last-child td {
    border-bottom: 0;
}

.site-name {
    font-weight: 700;
    margin-bottom: 6px;
}

.site-aliases {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
}

.site-alias {
    padding: 3px 8px;
    font-size: 10px;
    background: rgba(100, 116, 139, .10);
    color: inherit;
    opacity: .72;
}

.site-status {
    padding: 5px 9px;
    font-size: 11px;
    font-weight: 600;
}

.site-status-ok {
    color: #16a34a;
    background: rgba(34, 197, 94, .10);
}

.site-status-warning {
    color: #ca8a04;
    background: rgba(234, 179, 8, .12);
}

.document-root {
    white-space: nowrap;
}

.ssl-badge {
    padding: 5px 9px;
    font-size: 10px;
    font-weight: 700;
}

.ssl-enabled {
    color: #16a34a;
    background: rgba(34, 197, 94, .10);
}

.ssl-disabled {
    color: #64748b;
    background: rgba(100, 116, 139, .10);
}

.empty-state {
    padding: 48px 24px;
    text-align: center;
}

.empty-state-title {
    font-weight: 700;
    margin-bottom: 6px;
}

.empty-state-text {
    font-size: 13px;
    opacity: .62;
}

.panel-info-card {
    overflow: hidden;
}

.panel-info-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    padding: 20px 22px;
}

.panel-info-grid > div {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
}

.panel-info-label {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: .06em;
    opacity: .55;
}

@media (max-width: 900px) {
    .stats-grid,
    .panel-info-grid {
        grid-template-columns: 1fr;
    }

    .page-header {
        flex-direction: column;
    }
}

/* ============================================================
   HOSTING / SITIOS / DETALLE
   ============================================================ */

.panel-button {
    display: inline-flex;
    align-items: center;
    padding: 9px 13px;
    border-radius: 8px;
    border: 1px solid rgba(148, 163, 184, .20);
    text-decoration: none;
    font-size: 12px;
    font-weight: 600;
}

.detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
}

.detail-item {
    padding: 18px 22px;
    border-bottom: 1px solid rgba(148, 163, 184, .12);
}

.detail-item:nth-child(odd) {
    border-right: 1px solid rgba(148, 163, 184, .12);
}

.detail-item span {
    display: block;
    margin-bottom: 7px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .06em;
    opacity: .55;
}

.detail-item strong,
.detail-item code {
    font-size: 13px;
}

.detail-wide {
    grid-column: span 2;
}

.detail-ok {
    color: #16a34a;
}

.detail-warning {
    color: #ca8a04;
}

.domain-list {
    padding: 20px 22px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
}

.domain-primary,
.domain-alias,
.domain-empty {
    padding: 7px 10px;
    border-radius: 7px;
    font-size: 12px;
}

.domain-primary {
    font-weight: 700;
    background: rgba(34, 197, 94, .10);
}

.domain-alias {
    background: rgba(100, 116, 139, .10);
}

.domain-empty {
    opacity: .55;
}

.apache-config {
    margin: 0;
    padding: 22px;
    overflow-x: auto;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace;
    font-size: 12px;
    line-height: 1.65;
    background: rgba(15, 23, 42, .04);
}

@media (max-width: 800px) {
    .detail-grid {
        grid-template-columns: 1fr;
    }

    .detail-wide {
        grid-column: span 1;
    }

    .detail-item:nth-child(odd) {
        border-right: 0;
    }
}

/* ============================================================
   HOSTING / SITIOS / CREAR
   ============================================================ */

.site-form {
    padding: 22px;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
}

.form-group {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

.form-group-wide {
    grid-column: span 2;
}

.form-group label {
    font-size: 12px;
    font-weight: 700;
}

.form-group input,
.form-group select {
    width: 100%;
    box-sizing: border-box;
    padding: 11px 12px;
    border-radius: 8px;
    border: 1px solid rgba(148, 163, 184, .28);
    background: transparent;
    color: inherit;
    font: inherit;
}

.form-group small {
    font-size: 11px;
    opacity: .55;
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 24px;
}

.panel-button-primary {
    background: #2563eb;
    color: #fff;
    border-color: #2563eb;
}

@media (max-width: 800px) {
    .form-grid {
        grid-template-columns: 1fr;
    }

    .form-group-wide {
